{
  "name": "bluey-desktop",
  "productName": "Bluey",
  "version": "1.0.0",
  "description": "A blueberry who lives under your screen, points at things with his own cursor, and runs on your Claude or ChatGPT subscription.",
  "main": "src/main/main.js",
  "author": "Bluey",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:native": "sh native/build.sh",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --x64",
    "icons": "electron scripts/make-icons.js",
    "qa": "node scripts/qa.js"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.bluey.desktop",
    "productName": "Bluey",
    "copyright": "Bluey",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map"
    ],
    "extraResources": [
      {
        "from": "native/BlueyNative.exe",
        "to": "native/BlueyNative.exe"
      },
      {
        "from": "vendor/whisper",
        "to": "whisper"
      },
      {
        "from": "vendor/adb",
        "to": "adb"
      },
      {
        "from": "vendor/android/Bluey.apk",
        "to": "android/Bluey.apk"
      },
      {
        "from": "src/main/brain/mcp-bridge.js",
        "to": "bridge/mcp-bridge.js"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "executableName": "Bluey"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bluey",
      "runAfterFinish": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico"
    }
  }
}
